# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Public origin where the app is served. docker compose: http://localhost
# (prod: https://your-domain.com, dev: http://localhost:5173)
BETTER_AUTH_URL=http://localhost

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

# Request log verbosity (default: info). Use debug to inspect requests.
#LOG_LEVEL=info

# Postgres (used by docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app