# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Public origin where the app is served. docker compose: http://localhost:3000
# (prod: https://your-domain.com, dev: http://localhost:5173)
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

# Request log verbosity (default: info). Use debug to inspect requests.
#LOG_LEVEL=info

# Web Push (PWA notifications). Generate with: cd backend && npx web-push generate-vapid-keys
# Leave unset to run without push: /api/push/* returns 503 and the UI stays off.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# Postgres (used by docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app