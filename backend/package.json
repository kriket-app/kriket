{
	"name": "template-backend",
	"version": "0.1.0",
	"description": "",
	"license": "ISC",
	"author": "",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint . && prettier --check .",
		"lint:fix": "oxlint --fix . && prettier --write .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "npm run typecheck && npm run lint && npm test",
		"generate:openapi": "tsx src/openapi/generate.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"test": "vitest run",
		"test:watch": "vitest",
		"serve:test": "tsx src/index.ts"
	},
	"engines": {
		"node": ">=26"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.1.0",
		"better-auth": "^1.6.27",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.21.0",
		"@types/pino-http": "^5.8.4",
		"@types/supertest": "^7.2.1",
		"@types/swagger-ui-express": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"oxlint": "^1.78.0",
		"prettier": "^3.9.6",
		"supertest": "^7.2.2",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
