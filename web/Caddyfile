# The app's own front door: plain HTTP on :3000, same-origin for the frontend and the API so Better
# Auth cookies just work. TLS and the public hostname are the Docker box's Caddy's job
# (app.26.cohack.tetl.ca -> this container), so nothing here knows about domains or certificates.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:3000 {
	encode zstd gzip

	# PWA: the service worker must always revalidate so updates are picked up;
	# the manifest revalidates hourly; version-hashed icons are immutable.
	header /service-worker.js Cache-Control "no-cache"
	header /manifest.webmanifest Cache-Control "public, max-age=3600"
	header /icon-*.png Cache-Control "public, max-age=31536000, immutable"
	header /apple-touch-icon.png Cache-Control "public, max-age=31536000, immutable"
	header /icon.svg Cache-Control "public, max-age=31536000, immutable"

	handle /api/* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}
}
